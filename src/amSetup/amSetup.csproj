<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <OutputType Condition="'$(UseWindowsGui)' == 'true'">WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <TargetFramework Condition="'$(UseWindowsGui)' == 'true'">net10.0-windows</TargetFramework>
    <UseWindowsForms Condition="'$(UseWindowsGui)' == 'true'">true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <ApplicationIcon>..\..\assets\amsetup.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\amsetup.ico" Link="assets\amsetup.ico" />
    <EmbeddedResource Include="..\..\assets\amsetup-oldschool-icon-256.png" Link="assets\amsetup-oldschool-icon-256.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\amSetup.Compression\amSetup.Compression.csproj" />
  </ItemGroup>

</Project>
