<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <ApplicationIcon>..\..\assets\amsetup.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\amsetup.ico" Link="assets\amsetup.ico" />
    <EmbeddedResource Include="..\..\assets\amsetup-oldschool-icon-256.png" Link="assets\amsetup-oldschool-icon-256.png" />
  </ItemGroup>

</Project>
